{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yamileth-gill",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // a API e o painel passam primeiro pelo worker (login, dados); o resto é estático
    "run_worker_first": ["/api/*", "/dashboard", "/dashboard/*"]
  },
  
  "observability": { "enabled": true }
}
